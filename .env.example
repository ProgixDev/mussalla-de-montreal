# Copy to .env.local and fill in real values (never commit real env files).
# Server vars are parsed in src/core/env.ts (server-only); client vars in
# src/core/env.client.ts. Unparsed env access fails review.
#
# ⚠️  NEXT_PUBLIC_* is inlined into the BROWSER bundle — never put a secret there.
#
# The app runs today with NO backend (seed data in src/core/data). These vars are
# only needed once you wire Supabase + Square (see README → "Wiring the backend").

# NODE_ENV is set by Next.js automatically.

# Public site URL — drives canonical/OG URLs and the TV QR code target.
# On Vercel you can leave this UNSET: the deploy's own production domain is used
# automatically, so the TV QR code is correct without any configuration. Set it only
# once there is a custom domain (e.g. "https://mussalla-mtl.ca").
#
# A localhost value is ignored on Vercel on purpose — a TV QR pointing at localhost
# sends every donor to their own phone and silently loses the donation.
#
# To test the QR from a real phone in dev, put your LAN address here (the "Network"
# URL that `npm run dev` prints) and scan from a device on the same wifi:
#   NEXT_PUBLIC_SITE_URL="http://192.168.1.42:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (public: safe in the browser; RLS is the boundary) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# --- Server-only secrets (NEVER prefix NEXT_PUBLIC_) ---
# service_role bypasses RLS — used only in trusted server code.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Square (Canada, CAD). Build against the SANDBOX first. ---
# Get these from the Square Developer Dashboard → your application.
# SQUARE_ENV="sandbox"                       # "sandbox" | "production"
# NEXT_PUBLIC_SQUARE_APPLICATION_ID="sandbox-sq0idb-..."   # public: mounts the Web Payments SDK
# NEXT_PUBLIC_SQUARE_LOCATION_ID="L..."                    # public: the mussalla's location
# SQUARE_ACCESS_TOKEN="EAAA..."              # server-only: create payments/subscriptions
# SQUARE_WEBHOOK_SIGNATURE_KEY="..."         # server-only: verify webhook signatures (REQUIRED)
